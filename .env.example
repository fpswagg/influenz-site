# ============================================
# DATABASE (Postgres)
# ============================================
DATABASE_URL=postgresql://influenz:influenz@localhost:5433/influenz?schema=public

# ============================================
# DASHBOARD AUTH
# ============================================
DASHBOARD_PASSWORD=change-me
SESSION_SECRET=replace-with-a-long-random-string-32chars

# ============================================
# SA STORAGE
# ============================================
SA_STORAGE_URL=https://sastorage.fpswagg.site
SA_STORAGE_PUBLIC_URL=https://sastorage.fpswagg.site
SA_STORAGE_TOKEN=sa_your_token_here

# ============================================
# CONTACT FORM DELIVERY
# ============================================
CONTACT_FORM_RECIPIENT_EMAIL=contact@influenz.cm
EMAIL_SERVICE=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-email-password
SMTP_FROM_NAME=iNFLUENZ
SMTP_FROM_EMAIL=noreply@influenz.cm
RESEND_API_KEY=re_your_api_key_here
SENDGRID_API_KEY=SG.your_api_key_here
MAILGUN_API_KEY=your_mailgun_api_key
MAILGUN_DOMAIN=your_mailgun_domain
CONTACT_API_ENDPOINT=
CONTACT_API_KEY=

# ============================================
# SITE
# ============================================
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000
